#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ЗаполнитьДвиженияНачислений();
	ЗаполнитьДвиженияВзаиморасчетов();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьСписокСотрудников() Экспорт
	
	НачалоПериода = НачалоМесяца(Дата);
	КонецПериода  = КонецМесяца(Дата);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период", НачалоПериода);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.Сотрудник КАК Сотрудник,
	|	Т.Оклад КАК Оклад
	|ИЗ
	|	РегистрСведений.ВКМ_УсловияОплатыСотрудников.СрезПоследних(&Период, ) КАК Т
	|ГДЕ
	|	Т.Оклад > 0";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ЗапросРаботы = Новый Запрос;
	ЗапросРаботы.УстановитьПараметр("НачалоПериода", НачалоПериода);
	ЗапросРаботы.УстановитьПараметр("КонецПериода",  КонецПериода);
	ЗапросРаботы.Текст =
	"ВЫБРАТЬ
	|	Т.Сотрудник КАК Сотрудник,
	|	СУММА(Т.СуммаКОплате) КАК СуммаКОплате
	|ИЗ
	|	РегистрНакопления.ВКМ_ВыполненныеСотрудникомРаботы КАК Т
	|ГДЕ
	|	Т.Период >= &НачалоПериода
	|	И Т.Период <= &КонецПериода
	|
	|СГРУППИРОВАТЬ ПО
	|	Т.Сотрудник";
	
	ТаблицаРабот = ЗапросРаботы.Выполнить().Выгрузить();
	
	ЗапросОтпусков = Новый Запрос;
	ЗапросОтпусков.УстановитьПараметр("НачалоПериода", НачалоПериода);
	ЗапросОтпусков.УстановитьПараметр("КонецПериода",  КонецПериода);
	ЗапросОтпусков.Текст =
	"ВЫБРАТЬ
	|	Т.Сотрудник КАК Сотрудник,
	|	Т.ДатаНачала КАК ДатаНачала,
	|	Т.ДатаОкончания КАК ДатаОкончания
	|ИЗ
	|	Документ.ВКМ_ВводОтпуска КАК Т
	|ГДЕ
	|	Т.Проведен = ИСТИНА
	|	И Т.ДатаНачала <= &КонецПериода
	|	И Т.ДатаОкончания >= &НачалоПериода";
	
	ТаблицаОтпусков = ЗапросОтпусков.Выполнить().Выгрузить();
	
	РабДнейВМесяце = РабочихДнейВПериоде(НачалоПериода, КонецПериода);
	
	СписокСотрудников.Очистить();
	
	КоэффициентНДФЛ = Константы.ВКМ_ПроцентНДФЛ.КоэффициентНДФЛ();
	
	Пока Выборка.Следующий() Цикл
		
		СуммаОклада = 0;
		СуммаПроцентаОтРабот = 0;
		
		СтрОтпуска  = ТаблицаОтпусков.НайтиСтроки(Новый Структура("Сотрудник", Выборка.Сотрудник));
		Если СтрОтпуска.Количество() > 0 И РабДнейВМесяце > 0 Тогда
			
			РабДнейОтпуска = 0;
			Для Каждого СтрОтп Из СтрОтпуска Цикл
				ДатаНачОтп = Макс(СтрОтп.ДатаНачала, НачалоПериода);
				ДатаКонОтп = Мин(СтрОтп.ДатаОкончания, КонецПериода);
				Если ДатаНачОтп <= ДатаКонОтп Тогда
					РабДнейОтпуска = РабДнейОтпуска + РабочихДнейВПериоде(ДатаНачОтп, ДатаКонОтп);
				КонецЕсли;
			КонецЦикла;
			
			ДнейРаботы   = РабДнейВМесяце - РабДнейОтпуска;
			СуммаОклада = Окр(Выборка.Оклад * ДнейРаботы / РабДнейВМесяце, 2);
			
		Иначе
			СуммаОклада = Выборка.Оклад;
		КонецЕсли;
		
		СтрокиРабот = ТаблицаРабот.НайтиСтроки(Новый Структура("Сотрудник", Выборка.Сотрудник));
		Если СтрокиРабот.Количество() > 0 Тогда
			СуммаПроцентаОтРабот = СтрокиРабот[0].СуммаКОплате;
		КонецЕсли;
		
		СуммаНДФЛ = Окр((СуммаОклада + СуммаПроцентаОтРабот) * КоэффициентНДФЛ, 2);
		
		ДобавитьСтрокуРасчета(
			Выборка.Сотрудник,
			НачалоПериода,
			КонецПериода,
			ПланыВидовРасчета.ВКМ_ОсновныеНачисления.Оклад,
			СуммаОклада);
		
		ДобавитьСтрокуРасчета(
			Выборка.Сотрудник,
			НачалоПериода,
			КонецПериода,
			ПланыВидовРасчета.ВКМ_ДополнительныеНачисления.ПроцентОтРабот,
			СуммаПроцентаОтРабот);
		
		ДобавитьСтрокуРасчета(
			Выборка.Сотрудник,
			НачалоПериода,
			КонецПериода,
			ПланыВидовРасчета.ВКМ_Удержания.НДФЛ,
			СуммаНДФЛ);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьСтрокуРасчета(Сотрудник, ПериодНачало, ПериодКонец, ВидРасчета, Сумма)
	
	Если Не ЗначениеЗаполнено(Сотрудник)
		Или Не ЗначениеЗаполнено(ВидРасчета)
		Или Сумма = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Строка = СписокСотрудников.Добавить();
	Строка.Сотрудник     = Сотрудник;
	Строка.ПериодНачало  = ПериодНачало;
	Строка.ПериодКонец   = ПериодКонец;
	Строка.ВидРасчета    = ВидРасчета;
	Строка.Сумма         = Сумма;
	
КонецПроцедуры

Функция РабочихДнейВПериоде(ДатаНач, ДатаКон)
	
	КолДней     = 0;
	ТекДата     = НачалоДня(ДатаНач);
	ДатаКонДень = НачалоДня(ДатаКон);
	
	Пока ТекДата <= ДатаКонДень Цикл
		
		НДН = ДеньНедели(ТекДата);
		Если НДН < 6 Тогда
			КолДней = КолДней + 1;
		КонецЕсли;
		
		ТекДата = ТекДата + 86400;
		
	КонецЦикла;
	
	Возврат КолДней;
	
КонецФункции

Процедура ЗаполнитьДвиженияНачислений()
	
	НачалоПериода = НачалоМесяца(Дата);
	
	Движения.ВКМ_ОсновныеНачисления.Записывать = Истина;
	Движения.ВКМ_ОсновныеНачисления.Очистить();
	Движения.ВКМ_ДополнительныеНачисления.Записывать = Истина;
	Движения.ВКМ_ДополнительныеНачисления.Очистить();
	Движения.ВКМ_Удержания.Записывать = Истина;
	Движения.ВКМ_Удержания.Очистить();
	
	Для Каждого Строка Из СписокСотрудников Цикл
		
		Если Не ЗначениеЗаполнено(Строка.Сотрудник)
			Или Не ЗначениеЗаполнено(Строка.ВидРасчета)
			Или Строка.Сумма = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТипЗнч(Строка.ВидРасчета) = Тип("ПланВидовРасчетаСсылка.ВКМ_ОсновныеНачисления") Тогда
			
			ДвижениеНачисления = Движения.ВКМ_ОсновныеНачисления.Добавить();
			ДвижениеНачисления.ПериодРегистрации = НачалоПериода;
			ДвижениеНачисления.ВидРасчета        = Строка.ВидРасчета;
			ДвижениеНачисления.Сотрудник         = Строка.Сотрудник;
			ДвижениеНачисления.Результат         = Строка.Сумма;
			
		ИначеЕсли ТипЗнч(Строка.ВидРасчета) = Тип("ПланВидовРасчетаСсылка.ВКМ_ДополнительныеНачисления") Тогда
			
			ДвижениеДопНачисления = Движения.ВКМ_ДополнительныеНачисления.Добавить();
			ДвижениеДопНачисления.ПериодРегистрации = НачалоПериода;
			ДвижениеДопНачисления.ВидРасчета        = Строка.ВидРасчета;
			ДвижениеДопНачисления.Сотрудник         = Строка.Сотрудник;
			ДвижениеДопНачисления.Результат         = Строка.Сумма;
			
		ИначеЕсли ТипЗнч(Строка.ВидРасчета) = Тип("ПланВидовРасчетаСсылка.ВКМ_Удержания") Тогда
			
			ДвижениеУдержания = Движения.ВКМ_Удержания.Добавить();
			ДвижениеУдержания.ПериодРегистрации = НачалоПериода;
			ДвижениеУдержания.ВидРасчета        = Строка.ВидРасчета;
			ДвижениеУдержания.Сотрудник         = Строка.Сотрудник;
			ДвижениеУдержания.Результат         = Строка.Сумма;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьДвиженияВзаиморасчетов()
	
	Движения.ВКМ_ВзаиморасчетыССотрудниками.Записывать = Истина;
	Движения.ВКМ_ВзаиморасчетыССотрудниками.Очистить();
	
	СуммыПоСотрудникам = Новый Соответствие;
	
	Для Каждого Строка Из СписокСотрудников Цикл
		
		Если Не ЗначениеЗаполнено(Строка.Сотрудник)
			Или Не ЗначениеЗаполнено(Строка.ВидРасчета)
			Или Строка.Сумма = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СуммаКВзаиморасчетам = 0;
		Если ТипЗнч(Строка.ВидРасчета) = Тип("ПланВидовРасчетаСсылка.ВКМ_ОсновныеНачисления") Тогда
			СуммаКВзаиморасчетам = Строка.Сумма;
		ИначеЕсли ТипЗнч(Строка.ВидРасчета) = Тип("ПланВидовРасчетаСсылка.ВКМ_ДополнительныеНачисления") Тогда
			СуммаКВзаиморасчетам = Строка.Сумма;
		ИначеЕсли ТипЗнч(Строка.ВидРасчета) = Тип("ПланВидовРасчетаСсылка.ВКМ_Удержания") Тогда
			СуммаКВзаиморасчетам = -Строка.Сумма;
		Иначе
			Продолжить;
		КонецЕсли;
		
		ТекущаяСумма = СуммыПоСотрудникам[Строка.Сотрудник];
		Если ТекущаяСумма = Неопределено Тогда
			СуммыПоСотрудникам.Вставить(Строка.Сотрудник, СуммаКВзаиморасчетам);
		Иначе
			СуммыПоСотрудникам[Строка.Сотрудник] = ТекущаяСумма + СуммаКВзаиморасчетам;
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого ЭлементСуммы Из СуммыПоСотрудникам Цикл
		
		Если ЭлементСуммы.Значение = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Движение = Движения.ВКМ_ВзаиморасчетыССотрудниками.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период      = Дата;
		Движение.Сотрудник   = ЭлементСуммы.Ключ;
		Движение.Сумма       = ЭлементСуммы.Значение;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
